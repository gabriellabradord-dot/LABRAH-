# Copia este archivo a .env localmente. No subas .env ni credenciales reales.
PORT=3000
NODE_ENV=development
# Si DATABASE_URL no existe, se crea backend/db.sqlite automáticamente.
# En Render/Railway puedes usar DATABASE_URL=postgresql://...
DATABASE_URL=
SQLITE_PATH=./db.sqlite
# Configura este secreto aleatorio y largo en el panel del proveedor al publicar.
SESSION_SECRET=cambia-por-un-secreto-aleatorio-de-al-menos-32-caracteres
# En desarrollo puedes usar *; en producción usa los orígenes exactos separados por comas.
CORS_ORIGINS=https://gabriellabradord-dot.github.io
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administración LABRAH
